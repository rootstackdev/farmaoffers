<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[@class='buttons']" position="inside">
            <t t-esc="console.log(env)"/>
            <t t-if="(env.pos.company.invoicing_mode == '01' || env.pos.company.invoicing_mode == '03') &amp;&amp; env.pos.get_order().is_to_invoice()">
                <div class="button print" t-on-click="fiscalPrint">
                    <i class="fa fa-print"/>
                    Impresión Fiscal
                </div>
            </t>
            <t t-if="(env.pos.company.invoicing_mode == '02' || env.pos.company.invoicing_mode == '03') &amp;&amp; env.pos.get_order().is_to_invoice() &amp;&amp; env.pos.invoiceJournal.ei_document_type">
                <div class="button print" t-on-click="downloadPdf">
                    <i class="fa fa-print"/>
                    Factura Electrónica PDF
                </div>
            </t>
        </xpath>
    </t>
</templates>