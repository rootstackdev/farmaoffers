<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="FiscalPrintPopup" owl="1">
        <div role="dialog" class="modal-dialog">
            <Draggable>
                <div class="popup popup-selection">
                    <header class="title drag-handle">
                        Seleccionar Impresora
                    </header>
                    <div class="selection scrollable-y">
                        <t t-foreach="props.printers" t-as="item" t-key="item.id">
                            <div class="selection-item" t-att-class="{ selected: item.id.toString() === state.selectedId.toString() }"
                                 t-on-click="selectItem(item.id)">
                                <t t-esc="item.model" />
                            </div>
                        </t>
                    </div>
                    <footer class="footer">
                        <div class="button cancel" t-on-click="cancel">
                            Cancelar
                        </div>
                    </footer>
                </div>
            </Draggable>
        </div>
    </t>

</templates>
