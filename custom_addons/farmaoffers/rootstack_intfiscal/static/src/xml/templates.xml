<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fiscal_printer_footer">
        <div>
            <button class="btn btn-secondary js_confirm_print" disabled="true">Imprimir</button>
            <button class="btn btn-secondary js_cancel">Cancel</button>
        </div>
    </t>
    <t t-name="fiscal_printer">
        <div>
            <div class="row mb-3">
                <label for="printers" class="col-sm-4 col-form-label o_form_label o_required_modifier">Impresoras disponibles</label>
                <div class="col-sm-8">
                    <select class="o_input o_field_widget o_required_modifier" name="printer_options" id="printers"
                            disabled="true">
                        <option value="false">Cargando impresoras ...</option>
                    </select>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-8 offset-sm-4">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chk_default_printer" disabled="true"/>
                      <label class="form-check-label" for="chk_default_printer">
                      Impresora predeterminada
                    </label>
                  </div>
                </div>
            </div>
        </div>
    </t>
</templates>