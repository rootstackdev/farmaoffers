<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='analytic']" position="after">
                    <h2>intfiscal configuration</h2>
                    <div class="row mt16 o_settings_container" name="intfiscal_setting_container">
                        <div class="col-12 col-lg-8 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="intfiscal_url" string="URL" class="col-lg-3 o_light_label"/>
                                        <field name="intfiscal_url"/>
                                    </div>
                                    <div class="row">
                                        <label string="Token" for="intfiscal_token" class="col-lg-3 o_light_label"/>
                                        <field name="intfiscal_token"/>
                                    </div>
                                    <div class="row">
                                        <label string="Default printer" for="intfiscal_default_printer"
                                               class="col-lg-3 o_light_label"/>
                                        <field name="intfiscal_default_printer"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>