<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_company_form_inherit" model="ir.ui.view">
            <field name="name">res.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Invoicing Config" name="invoicing_config">
                        <group>
                            <group>
                                <field name="invoicing_mode"/>
                            </group>
                            <group/>
                        </group>
                        <group string="Customer Config"
                               attrs="{'invisible': [('invoicing_mode','not in',('01','03'))]}">
                            <group>
                                <field name="ruc"/>
                                <field name="dv"/>
                                <field name="tipo_contribuyente"/>
                            </group>
                            <group/>
                        </group>
                        <group string="Electronic Invoice Credentials"
                               attrs="{'invisible': [('invoicing_mode','not in',('02','03'))]}">
                            <group>
                                <field name="einvoice_ws_host"/>
                                <field name="einvoice_ws_token"/>
                                <field name="einvoice_ws_password" password="True"/>
                                <field name="einvoice_custom_field"/>
                            </group>
                            <group/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>