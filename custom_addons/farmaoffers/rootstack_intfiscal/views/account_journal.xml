<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="account_journal_form_view_inherit" model="ir.ui.view">
            <field name="name">account.journal.form.view.inherit</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Electronic Invoice Config">
                        <group>
                            <group>
                                <field name="ei_document_type"/>
                                <field name="ei_branch_type"/>
                                <field name="ei_branch_code"/>
                                <field name="sequence_id"/>
                            </group>
                            <group/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>