<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="wizard_ei_cancel_reason_view_form" model="ir.ui.view">
            <field name="name">wizard_ei_cancel_reason_view_form</field>
            <field name="model">wizard.ei.cancel.reason</field>
            <field name="arch" type="xml">
                <form string="wizard_ei_cancel_reason_form">
                    <sheet>
                        <group>
                            <field name="reason"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_cancel_document" type="object" string="Anular" class="btn-primary"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>